---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  SITE_NAME,
  GUIDES,
  LAST_VERIFIED_DATE,
  OFFICIAL_STD_LINKS,
  absoluteUrl,
} from '../lib/site';

interface StepItem {
  name: string;
  text: string;
}

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  updatedAt?: string;
  howToSteps?: StepItem[];
  faqs?: FaqItem[];
  citations?: string[];
}

const {
  title,
  description,
  canonicalPath,
  updatedAt = LAST_VERIFIED_DATE,
  howToSteps = [],
  faqs = [],
  citations = [OFFICIAL_STD_LINKS.openstd2025],
} = Astro.props;

const schemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: SITE_NAME,
        item: absoluteUrl('/'),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: title,
        item: absoluteUrl(canonicalPath),
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description,
    datePublished: '2026-07-01',
    dateModified: updatedAt,
    inLanguage: 'zh-CN',
    author: {
      '@type': 'Organization',
      name: SITE_NAME,
      url: absoluteUrl('/'),
    },
    citation: citations,
    mainEntityOfPage: absoluteUrl(canonicalPath),
  },
];

if (howToSteps.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: title,
    description,
    step: howToSteps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.name,
      text: s.text,
    })),
  });
}

if (faqs.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  });
}

const otherGuides = GUIDES.filter((g) => g.path !== canonicalPath);
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} schemas={schemas}>
  <main class="article-shell">
    <nav class="breadcrumb" aria-label="面包屑导航">
      <a href="/">{SITE_NAME}首页</a>
      <span aria-hidden="true">/</span>
      <span>GB/T 7714—2025 指南</span>
    </nav>

    <article class="prose-content">
      <header class="article-header">
        <h1>{title}</h1>
        <div class="article-meta">
          <span>依据标准：GB/T 7714—2025（2026-07-01 实施）</span>
          <span>最后核验：{updatedAt}</span>
        </div>
      </header>

      <slot />

      {faqs.length > 0 && (
        <section aria-labelledby="guide-faq-heading">
          <h2 id="guide-faq-heading">常见问题解答</h2>
          <div class="faq-list">
            {faqs.map((f) => (
              <div class="faq-item">
                <h3>{f.q}</h3>
                <p>{f.a}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <section aria-labelledby="related-guides-heading">
        <h2 id="related-guides-heading">更多 GB/T 7714—2025 参考文献指南</h2>
        <div class="guides-grid">
          {otherGuides.map((g) => (
            <a href={g.path} class="guide-link-card">
              <strong>{g.shortTitle}</strong>
              <span>{g.description}</span>
            </a>
          ))}
        </div>
      </section>
    </article>
  </main>
</BaseLayout>
